pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'docker build -t myrepo/devops-app .'
            }
        }
        stage('Test') {
            steps {
                sh 'pytest tests/'
            }
        }
        stage('Deploy') {
            steps {
                sh 'kubectl apply -f kubernetes/'
            }
        }
    }
}


