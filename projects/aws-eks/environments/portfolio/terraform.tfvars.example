account_id = "123456789012" # Replace with your sandbox account.
admin_role_arn = "arn:aws:iam::123456789012:role/EKSPortfolioAdmin"
# The role must already exist and be assumable by your operator identity.
# Private-only API requires a runner/VPN inside the VPC for kubectl and Helm.
public_access_cidrs = []
private_access_cidrs = [] # Set to your routed VPN/runner private source CIDR.
single_nat_gateway = true # Set false for one NAT per AZ.
# Scaling bounds are NOT an autoscaler. Terraform owns desired capacity.
node_groups = {
  system = { min = 2, desired = 2, max = 3, instance_types = ["t3.medium"] }
}
